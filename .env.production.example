# Public HTTPS origin of the deployed inference web service.
NEXT_PUBLIC_INFERENCE_API_URL=https://housing-value-explorer-api.onrender.com

# Exact browser origins allowed to call the API, separated by commas.
HOUSING_ALLOWED_ORIGINS=https://housing-value-explorer.onrender.com,https://housing.example.com

# One numerical thread for the Render 1c-2g service.
HOUSING_NUM_THREADS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Maximum accepted JSON request body in bytes.
HOUSING_MAX_REQUEST_BYTES=100000
